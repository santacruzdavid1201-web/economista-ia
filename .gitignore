# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Entornos virtuales
.venv*/

# Secretos
.env

# Datos (pesados o privados de las empresas)
data/raw/*
!data/raw/.gitkeep

# Salidas de exploración regenerables (se versiona solo el catálogo)
exploracion/salidas/*/
exploracion/salidas/log_*.txt

# Grafo de conocimiento (graphify), se regenera
graphify-out/
exploracion/salidas/*_hoteles_*.csv
exploracion/salidas/caratula_*.csv

# Informes del set de evaluación (se regeneran con python -m app.eval)
data/eval/

# Configuración local de Obsidian e informe de graphify (se regenera)
docs/.obsidian/
docs/GRAPH_REPORT.md

# Copias del día de las series macro (el respaldo versionado está en data/series/)
data/cache/
