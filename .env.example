# Copiar como .env (no se versiona) y ajustar. Las variables del sistema
# tienen prioridad sobre este archivo.

# Servidor compatible con la API de OpenAI.
# LM Studio: http://localhost:1234/v1  |  Ollama: http://localhost:11434/v1
LLM_URL=http://localhost:1234/v1
LLM_MODELO=qwen2.5-7b-instruct

# Solo para proveedores con API (demo pública). Nunca escribir la clave en el código.
LLM_API_KEY=

# Segundos máximos por llamada al modelo
LLM_TIMEOUT=300

# Validación de entrada
MAX_CARACTERES_PREGUNTA=1000
